<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GestionHorariosSENA" targetNamespace="http://sena.edu.co/gestion-horarios" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="Process_GestionHorariosSENA" name="Gestión de Horarios SENA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_GestionHorarios">
      <bpmn:lane id="Lane_Aprendiz" name="Aprendiz">
        <bpmn:flowNodeRef>Task_ConsultarPublicados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Consulta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Instructor" name="Instructor">
        <bpmn:flowNodeRef>Task_ConsultarAsignados</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Task_GuardarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarCredenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarPermisos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarDisponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerarConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarAjustar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CambiarEstadoPublicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExistenConflictos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="Coordinador Académico">
        <bpmn:flowNodeRef>Task_IniciarSesion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntrarHorarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeleccionarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgregarSesiones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardarBorrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublicarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Publicacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HayConflictos</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Inicio" name="Inicio" />
    <bpmn:userTask id="Task_IniciarSesion" name="1. Iniciar sesión en el sistema" />
    <bpmn:serviceTask id="Task_ValidarCredenciales" name="Validar credenciales de usuario" />
    <bpmn:userTask id="Task_EntrarHorarios" name="2. Ingresar al módulo de Horarios" />
    <bpmn:serviceTask id="Task_VerificarPermisos" name="Verificar permisos del coordinador" />
    <bpmn:userTask id="Task_CrearHorario" name="3. Crear nuevo horario" />
    <bpmn:serviceTask id="Task_ValidarDisponibilidad" name="Validar disponibilidad de instructores, ambientes y fichas" />
    <bpmn:exclusiveGateway id="Gateway_ExistenConflictos" name="¿Existen conflictos?" />
    <bpmn:serviceTask id="Task_GenerarConflictos" name="Generar listado de conflictos detectados" />
    <bpmn:userTask id="Task_SeleccionarDatos" name="4. Seleccionar ficha, periodo y nombre" />
    <bpmn:userTask id="Task_AgregarSesiones" name="5. Agregar sesiones al horario" />
    <bpmn:userTask id="Task_GuardarBorrador" name="6. Guardar borrador">
      <bpmn:outgoing>Flow_1qxj146</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GuardarHorario" name="Guardar horario en estado borrador" />
    <bpmn:userTask id="Task_ValidarHorario" name="7. Validar horario">
      <bpmn:incoming>Flow_1qxj146</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HayConflictos" name="¿Hay conflictos?" />
    <bpmn:userTask id="Task_RevisarAjustar" name="8. Revisar y ajustar conflictos" />
    <bpmn:userTask id="Task_PublicarHorario" name="9. Publicar horario" />
    <bpmn:serviceTask id="Task_CambiarEstadoPublicado" name="Cambiar estado a publicado" />
    <bpmn:endEvent id="EndEvent_Publicacion" name="Fin (Publicación exitosa)" />
    <bpmn:userTask id="Task_ConsultarAsignados" name="Consultar horarios asignados" />
    <bpmn:userTask id="Task_ConsultarPublicados" name="Consultar horarios publicados" />
    <bpmn:endEvent id="EndEvent_Consulta" name="Fin (Consulta)" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Inicio" targetRef="Task_IniciarSesion" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IniciarSesion" targetRef="Task_ValidarCredenciales" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarCredenciales" targetRef="Task_EntrarHorarios" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_EntrarHorarios" targetRef="Task_VerificarPermisos" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_VerificarPermisos" targetRef="Task_CrearHorario" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CrearHorario" targetRef="Task_ValidarDisponibilidad" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ValidarDisponibilidad" targetRef="Gateway_ExistenConflictos" />
    <bpmn:sequenceFlow id="Flow_08_Si" name="Sí" sourceRef="Gateway_ExistenConflictos" targetRef="Task_GenerarConflictos" />
    <bpmn:sequenceFlow id="Flow_09_No" name="No" sourceRef="Gateway_ExistenConflictos" targetRef="Task_SeleccionarDatos" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_GenerarConflictos" targetRef="Task_RevisarAjustar" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SeleccionarDatos" targetRef="Task_AgregarSesiones" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AgregarSesiones" targetRef="Task_GuardarBorrador" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_GuardarBorrador" targetRef="Task_GuardarHorario" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_GuardarHorario" targetRef="Task_ValidarHorario" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ValidarHorario" targetRef="Gateway_HayConflictos" />
    <bpmn:sequenceFlow id="Flow_16_Si" name="Sí" sourceRef="Gateway_HayConflictos" targetRef="Task_RevisarAjustar" />
    <bpmn:sequenceFlow id="Flow_17_No" name="No" sourceRef="Gateway_HayConflictos" targetRef="Task_PublicarHorario" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RevisarAjustar" targetRef="Task_AgregarSesiones" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PublicarHorario" targetRef="Task_CambiarEstadoPublicado" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CambiarEstadoPublicado" targetRef="EndEvent_Publicacion" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CambiarEstadoPublicado" targetRef="Task_ConsultarAsignados" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ConsultarAsignados" targetRef="Task_ConsultarPublicados" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ConsultarPublicados" targetRef="EndEvent_Consulta" />
    <bpmn:sequenceFlow id="Flow_1qxj146" sourceRef="Task_GuardarBorrador" targetRef="Task_ValidarHorario" />
  </bpmn:process>
