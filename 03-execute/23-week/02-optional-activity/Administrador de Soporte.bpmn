<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Soporte_SENA_Pools" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Soporte_SENA">
    <bpmn:participant id="Participant_SoporteSENA" name="Sistema de Gestión de Horarios SENA - Módulo Administrador de Soporte" processRef="Process_Soporte_Pools" />
    <bpmn:participant id="Participant_UsuariosSoporte" name="Usuarios / Canales de Ayuda" processRef="Process_UsuariosSoporteDummy" />
    <bpmn:messageFlow id="MessageFlow_Ticket" sourceRef="Participant_UsuariosSoporte" targetRef="Task_GestionarTickets" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Soporte_Pools" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Soporte">
      <bpmn:lane id="Lane_Soporte" name="Administrador de Soporte">
        <bpmn:flowNodeRef>Start_LoginSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidaLoginSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccionTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionarRespaldos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginCredencialesSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecuperarPassSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanelSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorearLogs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionarTickets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResponderTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Soporte</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SistemaSoporte" name="Plataforma / Backend">
        <bpmn:flowNodeRef>Task_ProcesarLoginSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EjecutarRespaldoBackend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_LoginSoporte" name="Pantalla Login">
      <bpmn:outgoing>Flow_SL1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ValidaLoginSoporte" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_1yhl2wt</bpmn:incoming>
      <bpmn:outgoing>Flow_SopOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_SopRecuperar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AccionTicket" name="¿Atender / Responder Ticket?">
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_VerTicket</bpmn:outgoing>
      <bpmn:outgoing>Flow_CerrarTickets</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GestionarRespaldos" name="Configurar / Ejecutar Respaldo de Base de Datos">
      <bpmn:incoming>Flow_OptBackups</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBackupBackend</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_SL1" sourceRef="Start_LoginSoporte" targetRef="Task_LoginCredencialesSoporte" />
    <bpmn:sequenceFlow id="Flow_SL2" sourceRef="Task_LoginCredencialesSoporte" targetRef="Task_ProcesarLoginSoporte" />
    <bpmn:sequenceFlow id="Flow_ToGatewayLoginSop" sourceRef="Task_ProcesarLoginSoporte" targetRef="Task_RecuperarPassSoporte" />
    <bpmn:sequenceFlow id="Flow_SopOK" name="Sí" sourceRef="Gateway_ValidaLoginSoporte" targetRef="Task_PanelSoporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SopRecuperar" name="No" sourceRef="Gateway_ValidaLoginSoporte" targetRef="Task_RecuperarPassSoporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RecupBackSop" sourceRef="Task_RecuperarPassSoporte" targetRef="Task_LoginCredencialesSoporte" />
    <bpmn:sequenceFlow id="Flow_MenuSoporte" sourceRef="Task_PanelSoporte" targetRef="Gateway_MenuSoporte" />
    <bpmn:sequenceFlow id="Flow_OptTickets" name="Tickets" sourceRef="Gateway_MenuSoporte" targetRef="Task_GestionarTickets">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionSoporte = "tickets"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptLogs" name="Monitoreo" sourceRef="Gateway_MenuSoporte" targetRef="Task_MonitorearLogs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionSoporte = "logs"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptBackups" name="Respaldos" sourceRef="Gateway_MenuSoporte" targetRef="Task_GestionarRespaldos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionSoporte = "respaldos"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T1" sourceRef="Task_GestionarTickets" targetRef="Gateway_AccionTicket" />
    <bpmn:sequenceFlow id="Flow_VerTicket" name="Sí" sourceRef="Gateway_AccionTicket" targetRef="Task_ResponderTicket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=atenderTicket = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CerrarTickets" name="No" sourceRef="Gateway_AccionTicket" targetRef="End_Soporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=atenderTicket = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackTicket" sourceRef="Task_ResponderTicket" targetRef="End_Soporte" />
    <bpmn:sequenceFlow id="Flow_BackLogs" sourceRef="Task_MonitorearLogs" targetRef="End_Soporte" />
    <bpmn:sequenceFlow id="Flow_ToBackupBackend" sourceRef="Task_GestionarRespaldos" targetRef="Task_EjecutarRespaldoBackend" />
    <bpmn:sequenceFlow id="Flow_BackBackups" sourceRef="Task_EjecutarRespaldoBackend" targetRef="End_Soporte" />
    <bpmn:serviceTask id="Task_ProcesarLoginSoporte" name="Validar Credenciales Soporte Backend">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validar-login-soporte" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SL2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayLoginSop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_LoginCredencialesSoporte" name="Ingresar Correo y Contraseña Institucional">
      <bpmn:incoming>Flow_SL1</bpmn:incoming>
      <bpmn:incoming>Flow_RecupBackSop</bpmn:incoming>
      <bpmn:outgoing>Flow_SL2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1yhl2wt" sourceRef="Task_RecuperarPassSoporte" targetRef="Gateway_ValidaLoginSoporte" />
    <bpmn:userTask id="Task_RecuperarPassSoporte" name="Recuperar Contraseña por Correo">
      <bpmn:incoming>Flow_SopRecuperar</bpmn:incoming>
      <bpmn:incoming>Flow_ToGatewayLoginSop</bpmn:incoming>
      <bpmn:outgoing>Flow_RecupBackSop</bpmn:outgoing>
      <bpmn:outgoing>Flow_1yhl2wt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanelSoporte" name="Visualizar Panel Principal Soporte (Mantenimiento y Tickets)">
      <bpmn:incoming>Flow_SopOK</bpmn:incoming>
      <bpmn:outgoing>Flow_MenuSoporte</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MenuSoporte" name="¿Qué opción del menú selecciona?">
      <bpmn:incoming>Flow_MenuSoporte</bpmn:incoming>
      <bpmn:outgoing>Flow_OptTickets</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptLogs</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptBackups</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MonitorearLogs" name="Monitorear Logs del Sistema y Alertas de Errores">
      <bpmn:incoming>Flow_OptLogs</bpmn:incoming>
      <bpmn:outgoing>Flow_BackLogs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_GestionarTickets" name="Consultar Bandeja de Tickets de Soporte">
      <bpmn:incoming>Flow_OptTickets</bpmn:incoming>
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_EjecutarRespaldoBackend" name="Generar Copia de Seguridad en Servidor">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generar-respaldo-bd" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBackupBackend</bpmn:incoming>
      <bpmn:outgoing>Flow_BackBackups</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ResponderTicket" name="Redactar Solución y Actualizar Estado del Ticket">
      <bpmn:incoming>Flow_VerTicket</bpmn:incoming>
      <bpmn:outgoing>Flow_BackTicket</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Soporte" name="Sesión / Tareas Finalizadas">
      <bpmn:incoming>Flow_BackTicket</bpmn:incoming>
      <bpmn:incoming>Flow_CerrarTickets</bpmn:incoming>
      <bpmn:incoming>Flow_BackLogs</bpmn:incoming>
      <bpmn:incoming>Flow_BackBackups</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_UsuariosSoporteDummy" isExecutable="false" />
  <di:BPMNDiagram id="BPMNDiagram_1">
    <di:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Soporte_SENA">
