      <di:BPMNEdge id="Flow_LI2_di" bpmnElement="Flow_LI2">
        <di_1:waypoint x="360" y="290" />
        <di_1:waypoint x="435" y="290" />
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_InstOK_di" bpmnElement="Flow_InstOK">
        <di_1:waypoint x="485" y="290" />
        <di_1:waypoint x="540" y="290" />
        <di:BPMNLabel>
          <dc:Bounds x="502" y="272" width="11" height="14" />
        </di:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_InstRecuperar_di" bpmnElement="Flow_InstRecuperar">
        <di_1:waypoint x="460" y="315" />
        <di_1:waypoint x="460" y="380" />
        <di:BPMNLabel>
          <dc:Bounds x="468" y="336" width="15" height="14" />
        </di:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_MenuInstructor_di" bpmnElement="Flow_MenuInstructor">
        <di_1:waypoint x="640" y="290" />
