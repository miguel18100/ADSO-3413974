<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Instructor_Pools" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Instructor_SENA">
    <bpmn:participant id="Participant_InstructorSENA" name="Sistema de Gestión de Horarios SENA - Módulo Instructor" processRef="Process_Instructor_Pools" />
    <bpmn:participant id="Participant_Coordinacion" name="Coordinación Académica" processRef="Process_CoordinacionDummy" />
    <bpmn:messageFlow id="MessageFlow_Excepcion" sourceRef="Task_EnviarRevisionDispo" targetRef="Participant_Coordinacion" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Instructor_Pools" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Instructor">
      <bpmn:lane id="Lane_Instructor" name="Instructor">
        <bpmn:flowNodeRef>Gateway_ValidaLoginInst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccionSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginCredenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecuperarPassInst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanelInstructor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuInstructor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionDisponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerMiHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccionDispo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearExcepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidaExcepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirExcepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidaSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Instructor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_LoginInstructor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Plataforma / Backend">
        <bpmn:flowNodeRef>Task_EnviarRevisionDispo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuardarSeguimientoBackend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_ValidaLoginInst" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_LI2</bpmn:incoming>
      <bpmn:outgoing>Flow_InstOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_InstRecuperar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AccionSeguimiento" name="¿Registrar Nuevo Seguimiento?">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_NuevoSeguimiento</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinSeguimiento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CrearSeguimiento" name="Llenar Formulario Seguimiento (Asistencias, Avance)">
      <bpmn:incoming>Flow_NuevoSeguimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_LI1" sourceRef="Start_LoginInstructor" targetRef="Task_LoginCredenciales" />
    <bpmn:sequenceFlow id="Flow_1r3b1qb" sourceRef="Task_RecuperarPassInst" targetRef="Task_LoginCredenciales" />
    <bpmn:sequenceFlow id="Flow_LI2" sourceRef="Task_LoginCredenciales" targetRef="Gateway_ValidaLoginInst" />
    <bpmn:sequenceFlow id="Flow_InstOK" name="Sí" sourceRef="Gateway_ValidaLoginInst" targetRef="Task_PanelInstructor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InstRecuperar" name="No" sourceRef="Gateway_ValidaLoginInst" targetRef="Task_RecuperarPassInst">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MenuInstructor" sourceRef="Task_PanelInstructor" targetRef="Gateway_MenuInstructor" />
    <bpmn:sequenceFlow id="Flow_OptHorario" name="Mi Horario" sourceRef="Gateway_MenuInstructor" targetRef="Task_VerMiHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionInstructor = "horario"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptDisponibilidad" name="Mi Disponibilidad" sourceRef="Gateway_MenuInstructor" targetRef="Task_GestionDisponibilidad">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionInstructor = "disponibilidad"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptSeguimiento" name="Seguimiento" sourceRef="Gateway_MenuInstructor" targetRef="Task_GestionSeguimiento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionInstructor = "seguimiento"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackHorario" sourceRef="Task_VerMiHorario" targetRef="End_Instructor" />
    <bpmn:sequenceFlow id="Flow_D1" sourceRef="Task_GestionDisponibilidad" targetRef="Gateway_AccionDispo" />
    <bpmn:sequenceFlow id="Flow_NuevaExcepcion" name="Sí (+ Nueva excepción)" sourceRef="Gateway_AccionDispo" targetRef="Task_CrearExcepcion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionDispo = "nueva"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SinExcepcion" name="No" sourceRef="Gateway_AccionDispo" targetRef="End_Instructor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionDispo = "ninguna"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Task_CrearExcepcion" targetRef="Gateway_ValidaExcepcion" />
    <bpmn:sequenceFlow id="Flow_ErrorExcepcion" name="Sí (Alerta de fechas)" sourceRef="Gateway_ValidaExcepcion" targetRef="Task_CorregirExcepcion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=errorExcepcion = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OkExcepcion" name="No (Correcto)" sourceRef="Gateway_ValidaExcepcion" targetRef="Task_CorregirSeguimiento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=errorExcepcion = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegresaExcepcion" sourceRef="Task_CorregirExcepcion" targetRef="Gateway_ValidaExcepcion" />
    <bpmn:sequenceFlow id="Flow_BackDispo" sourceRef="Task_EnviarRevisionDispo" targetRef="End_Instructor" />
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Task_GestionSeguimiento" targetRef="Gateway_AccionSeguimiento" />
    <bpmn:sequenceFlow id="Flow_NuevoSeguimiento" name="Sí (+ Registrar seguimiento)" sourceRef="Gateway_AccionSeguimiento" targetRef="Task_CrearSeguimiento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionSeguimiento = "nuevo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinSeguimiento" name="No" sourceRef="Gateway_AccionSeguimiento" targetRef="End_Instructor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionSeguimiento = "ninguno"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_CrearSeguimiento" targetRef="Gateway_ValidaSeguimiento" />
    <bpmn:sequenceFlow id="Flow_ErrorSeguimiento" name="Sí (Supera matriculados)" sourceRef="Gateway_ValidaSeguimiento" targetRef="Task_CorregirSeguimiento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=errorAsistencia = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OkSeguimiento" name="No (Válido)" sourceRef="Gateway_ValidaSeguimiento" targetRef="Task_GuardarSeguimientoBackend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=errorAsistencia = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegresaSeguimiento" sourceRef="Task_CorregirSeguimiento" targetRef="Task_CrearSeguimiento" />
    <bpmn:sequenceFlow id="Flow_BackSeguimiento" sourceRef="Task_GuardarSeguimientoBackend" targetRef="End_Instructor" />
    <bpmn:userTask id="Task_LoginCredenciales" name="Ingresar Correo y Contraseña Institucional">
      <bpmn:incoming>Flow_LI1</bpmn:incoming>
      <bpmn:incoming>Flow_1r3b1qb</bpmn:incoming>
      <bpmn:outgoing>Flow_LI2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecuperarPassInst" name="Recuperar Contraseña por Correo">
      <bpmn:incoming>Flow_InstRecuperar</bpmn:incoming>
      <bpmn:outgoing>Flow_1r3b1qb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanelInstructor" name="Visualizar Panel Principal Instructor (Mi Horario)">
      <bpmn:incoming>Flow_InstOK</bpmn:incoming>
      <bpmn:outgoing>Flow_MenuInstructor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MenuInstructor" name="¿Qué opción del menú selecciona?">
      <bpmn:incoming>Flow_MenuInstructor</bpmn:incoming>
      <bpmn:outgoing>Flow_OptHorario</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptDisponibilidad</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptSeguimiento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GestionSeguimiento" name="Consultar Historial y Métricas de Seguimiento de Ficha">
      <bpmn:incoming>Flow_OptSeguimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_GestionDisponibilidad" name="Gestionar Disponibilidad y Excepciones Vigentes">
      <bpmn:incoming>Flow_OptDisponibilidad</bpmn:incoming>
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerMiHorario" name="Consultar Calendario de Clases Semanal">
      <bpmn:incoming>Flow_OptHorario</bpmn:incoming>
      <bpmn:outgoing>Flow_BackHorario</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AccionDispo" name="¿Registrar Nueva Excepción?">
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_NuevaExcepcion</bpmn:outgoing>
      <bpmn:outgoing>Flow_SinExcepcion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CrearExcepcion" name="Llenar Formulario Nueva Excepción (Fechas, Soporte)">
      <bpmn:incoming>Flow_NuevaExcepcion</bpmn:incoming>
      <bpmn:incoming>Flow_0vzblol</bpmn:incoming>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ValidaExcepcion" name="¿Fechas y Archivos Válidos?">
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:incoming>Flow_RegresaExcepcion</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorExcepcion</bpmn:outgoing>
      <bpmn:outgoing>Flow_OkExcepcion</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vzblol</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0vzblol" sourceRef="Gateway_ValidaExcepcion" targetRef="Task_CrearExcepcion" />
    <bpmn:userTask id="Task_CorregirExcepcion" name="Corregir Alertas de Formulario Excepción">
      <bpmn:incoming>Flow_ErrorExcepcion</bpmn:incoming>
      <bpmn:outgoing>Flow_RegresaExcepcion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1sl0qqc" sourceRef="Task_CorregirSeguimiento" targetRef="Task_EnviarRevisionDispo" />
    <bpmn:userTask id="Task_CorregirSeguimiento" name="Corregir Errores de Asistencia (Cupos)">
      <bpmn:incoming>Flow_ErrorSeguimiento</bpmn:incoming>
      <bpmn:incoming>Flow_OkExcepcion</bpmn:incoming>
      <bpmn:outgoing>Flow_RegresaSeguimiento</bpmn:outgoing>
      <bpmn:outgoing>Flow_1sl0qqc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ValidaSeguimiento" name="¿Asistentes menores o iguales a Matriculados?">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorSeguimiento</bpmn:outgoing>
      <bpmn:outgoing>Flow_OkSeguimiento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Instructor" name="Sesión / Tareas Finalizadas">
      <bpmn:incoming>Flow_BackHorario</bpmn:incoming>
      <bpmn:incoming>Flow_SinExcepcion</bpmn:incoming>
      <bpmn:incoming>Flow_BackDispo</bpmn:incoming>
      <bpmn:incoming>Flow_FinSeguimiento</bpmn:incoming>
      <bpmn:incoming>Flow_BackSeguimiento</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_EnviarRevisionDispo" name="Enviar Solicitud a Coordinación">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-solicitud-excepcion" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1sl0qqc</bpmn:incoming>
      <bpmn:outgoing>Flow_BackDispo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GuardarSeguimientoBackend" name="Guardar Registro en Sistema">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="guardar-seguimiento-sena" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OkSeguimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_BackSeguimiento</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_LoginInstructor" name="Pantalla Login">
      <bpmn:outgoing>Flow_LI1</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_CoordinacionDummy" isExecutable="false" />
  <di:BPMNDiagram id="BPMNDiagram_1">
    <di:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Instructor_SENA">
