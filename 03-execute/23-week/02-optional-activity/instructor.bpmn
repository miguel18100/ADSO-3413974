      </di:BPMNShape>
      <di:BPMNEdge id="Flow_LI1_di" bpmnElement="Flow_LI1">
        <di_1:waypoint x="228" y="290" />
        <di_1:waypoint x="260" y="290" />
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_1r3b1qb_di" bpmnElement="Flow_1r3b1qb">
        <di_1:waypoint x="410" y="420" />
