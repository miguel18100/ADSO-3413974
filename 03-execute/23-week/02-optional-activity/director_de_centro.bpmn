<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Director_SENA_Pools" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Director_SENA">
    <bpmn:participant id="Participant_DirectorSENA" name="Sistema de Gestión de Horarios SENA - Módulo Director de Centro" processRef="Process_Director_Pools" />
    <bpmn:participant id="Participant_AdminSedes" name="Gestión de Ambientes / Sedes" processRef="Process_SedesDummy" />
    <bpmn:messageFlow id="MessageFlow_Sedes" sourceRef="Participant_AdminSedes" targetRef="Task_DatosReferencia" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Director_Pools" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Director">
      <bpmn:lane id="Lane_Director" name="Director de Centro">
        <bpmn:flowNodeRef>Gateway_ValidaLoginDir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestionUsuarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorregirUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_LoginDirector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoginCredencialesDir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecuperarPassDir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PanelDirector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Parametrizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuDirector</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DatosReferencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccionUsuarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CrearUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerIndicadores</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidaUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Director</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SistemaDirector" name="Plataforma / Backend">
        <bpmn:flowNodeRef>Task_GuardarUsuarioBackend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_ValidaLoginDir" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_DL2</bpmn:incoming>
      <bpmn:outgoing>Flow_DirOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_DirRecuperar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GestionUsuarios" name="Administrar Cuentas de Usuarios">
      <bpmn:incoming>Flow_OptUsuarios</bpmn:incoming>
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CorregirUsuario" name="Corregir Correo Duplicado">
      <bpmn:incoming>Flow_ErrorUsuario</bpmn:incoming>
      <bpmn:outgoing>Flow_0jvvbrn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GuardarUsuarioBackend" name="Guardar Cuenta en el Sistema">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="guardar-usuario-sena" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OkUsuario</bpmn:incoming>
      <bpmn:outgoing>Flow_BackUsuarios</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_DL1" sourceRef="Start_LoginDirector" targetRef="Task_LoginCredencialesDir" />
    <bpmn:sequenceFlow id="Flow_0wg1kub" sourceRef="Task_RecuperarPassDir" targetRef="Task_LoginCredencialesDir" />
    <bpmn:sequenceFlow id="Flow_DL2" sourceRef="Task_LoginCredencialesDir" targetRef="Gateway_ValidaLoginDir" />
    <bpmn:sequenceFlow id="Flow_DirOK" name="Sí" sourceRef="Gateway_ValidaLoginDir" targetRef="Task_PanelDirector">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DirRecuperar" name="No" sourceRef="Gateway_ValidaLoginDir" targetRef="Task_RecuperarPassDir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MenuDirector" sourceRef="Task_PanelDirector" targetRef="Gateway_MenuDirector" />
    <bpmn:sequenceFlow id="Flow_OptIndicadores" name="Indicadores" sourceRef="Gateway_MenuDirector" targetRef="Task_VerIndicadores">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionDirector = "indicadores"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptUsuarios" name="Usuarios" sourceRef="Gateway_MenuDirector" targetRef="Task_GestionUsuarios">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionDirector = "usuarios"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptDatosRef" name="Datos de referencia" sourceRef="Gateway_MenuDirector" targetRef="Task_DatosReferencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionDirector = "datos_referencia"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptParametrizacion" name="Parametrización" sourceRef="Gateway_MenuDirector" targetRef="Task_Parametrizacion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionDirector = "parametrizacion"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackIndicadores" sourceRef="Task_VerIndicadores" targetRef="End_Director" />
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="Task_GestionUsuarios" targetRef="Gateway_AccionUsuarios" />
    <bpmn:sequenceFlow id="Flow_NuevoUsuario" name="Sí (+ Nuevo usuario)" sourceRef="Gateway_AccionUsuarios" targetRef="Task_CrearUsuario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionUsuario = "nuevo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinUsuarios" name="No" sourceRef="Gateway_AccionUsuarios" targetRef="End_Director">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accionUsuario = "ninguno"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0jvvbrn" sourceRef="Task_CorregirUsuario" targetRef="Task_CrearUsuario" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Task_CrearUsuario" targetRef="Gateway_ValidaUsuario" />
    <bpmn:sequenceFlow id="Flow_ErrorUsuario" name="Sí (Correo ya registrado)" sourceRef="Gateway_ValidaUsuario" targetRef="Task_CorregirUsuario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=correoRegistrado = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OkUsuario" name="No (Disponible)" sourceRef="Gateway_ValidaUsuario" targetRef="Task_GuardarUsuarioBackend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=correoRegistrado = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackUsuarios" sourceRef="Task_GuardarUsuarioBackend" targetRef="End_Director" />
    <bpmn:sequenceFlow id="Flow_BackParametrizacion" sourceRef="Task_Parametrizacion" targetRef="Task_DatosReferencia" />
    <bpmn:startEvent id="Start_LoginDirector" name="Pantalla Login">
      <bpmn:outgoing>Flow_DL1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LoginCredencialesDir" name="Ingresar Correo y Contraseña Institucional">
      <bpmn:incoming>Flow_DL1</bpmn:incoming>
      <bpmn:incoming>Flow_0wg1kub</bpmn:incoming>
      <bpmn:outgoing>Flow_DL2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecuperarPassDir" name="Recuperar Contraseña por Correo">
      <bpmn:incoming>Flow_DirRecuperar</bpmn:incoming>
      <bpmn:outgoing>Flow_0wg1kub</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanelDirector" name="Visualizar Panel Principal Director (Indicadores)">
      <bpmn:incoming>Flow_DirOK</bpmn:incoming>
      <bpmn:outgoing>Flow_MenuDirector</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Parametrizacion" name="Configurar Prerrequisitos, Catálogos y Parámetros">
      <bpmn:incoming>Flow_OptParametrizacion</bpmn:incoming>
      <bpmn:outgoing>Flow_BackParametrizacion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MenuDirector" name="¿Qué opción del menú selecciona?">
      <bpmn:incoming>Flow_MenuDirector</bpmn:incoming>
      <bpmn:outgoing>Flow_OptIndicadores</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptUsuarios</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptDatosRef</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptParametrizacion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DatosReferencia" name="Consultar y Mantener Datos de Referencia y Sedes">
      <bpmn:incoming>Flow_OptDatosRef</bpmn:incoming>
      <bpmn:incoming>Flow_BackParametrizacion</bpmn:incoming>
      <bpmn:outgoing>Flow_06bms2t</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_06bms2t" sourceRef="Task_DatosReferencia" targetRef="End_Director" />
    <bpmn:exclusiveGateway id="Gateway_AccionUsuarios" name="¿Crear Nuevo Usuario?">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_NuevoUsuario</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinUsuarios</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CrearUsuario" name="Llenar Formulario Nuevo Usuario (Correo, Rol)">
      <bpmn:incoming>Flow_NuevoUsuario</bpmn:incoming>
      <bpmn:incoming>Flow_0jvvbrn</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerIndicadores" name="Consultar KPIs, Riesgos y Gráficos de Fichas">
      <bpmn:incoming>Flow_OptIndicadores</bpmn:incoming>
      <bpmn:outgoing>Flow_BackIndicadores</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ValidaUsuario" name="¿Correo ya registrado?">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorUsuario</bpmn:outgoing>
      <bpmn:outgoing>Flow_OkUsuario</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Director" name="Sesión / Tareas Finalizadas">
      <bpmn:incoming>Flow_BackIndicadores</bpmn:incoming>
      <bpmn:incoming>Flow_FinUsuarios</bpmn:incoming>
      <bpmn:incoming>Flow_BackUsuarios</bpmn:incoming>
      <bpmn:incoming>Flow_06bms2t</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_SedesDummy" isExecutable="false" />
