@startuml
title Sistema Gestor de Ambulancias (SGA)\nDiagrama de Casos de Uso - G1-P1

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam usecase {
  BackgroundColor White
  BorderColor #2E4053
}
skinparam ArrowColor #566573

actor Administrador as Admin
actor "Coordinador Operativo" as Coordinador
actor "Personal Operativo\n(TES/Paramédico)" as Operativo
actor "Director / Gerencia" as Director

rectangle "Sistema Gestor de Ambulancias (SGA)" {

  package "Administración y acceso" {
    (CU-01 Iniciar sesión) as CU01
    (CU-02 Cerrar sesión) as CU02
    (CU-03 Consultar dashboard) as CU03
    (CU-04 Gestionar usuarios) as CU04
    (CU-05 Configurar sistema) as CU05
  }

  package "Gestión de recursos" {
    (CU-06 Gestionar ambulancias) as CU06
    (CU-07 Gestionar personal operativo) as CU07
    (CU-08 Consultar disponibilidad de recursos) as CU08
  }

  package "Gestión de solicitudes" {
    (CU-09 Registrar solicitud de servicio) as CU09
    (CU-10 Consultar solicitudes) as CU10
    (CU-11 Clasificar solicitud) as CU11
    (CU-12 Asignar ambulancia y personal) as CU12
    (CU-13 Consultar asignaciones) as CU13
  }

  package "Seguimiento operativo" {
    (CU-14 Actualizar estado del servicio) as CU14
    (CU-15 Registrar novedad del servicio) as CU15
    (CU-16 Consultar historial de servicios) as CU16
  }

  package "Informes y gestión" {
    (CU-17 Generar reportes operativos) as CU17
    (CU-18 Consultar indicadores de gestión) as CU18
  }
}

Admin --> CU01
Admin --> CU02
Admin --> CU03
Admin --> CU04
Admin --> CU05
Admin --> CU06
Admin --> CU07
Admin --> CU08

Coordinador --> CU01
Coordinador --> CU02
Coordinador --> CU03
Coordinador --> CU08
Coordinador --> CU09
Coordinador --> CU10
Coordinador --> CU11
Coordinador --> CU12
Coordinador --> CU13
Coordinador --> CU16
Coordinador --> CU17

Operativo --> CU01
Operativo --> CU02
Operativo --> CU13
Operativo --> CU14
Operativo --> CU15
Operativo --> CU16

Director --> CU01
Director --> CU02
Director --> CU03
Director --> CU16
Director --> CU17
Director --> CU18

CU12 ..> CU08 : <<include>>
CU12 ..> CU11 : <<include>>
CU14 ..> CU13 : <<extend>>
CU15 ..> CU14 : <<extend>>

note right of CU09
  Permite registrar la información
  necesaria para una solicitud
  de transporte asistencial.
end note

note right of CU11
  La clasificación se realiza de acuerdo
  con los criterios definidos para
  los servicios de transporte asistencial.
end note

note right of CU12
  La asignación considera la disponibilidad
  de ambulancias y personal operativo.
end note

note right of CU14
  Permite actualizar el estado operativo
  del servicio durante su ejecución.
end note

note right of CU15
  Permite documentar novedades
  relacionadas con la prestación
  del servicio.
end note

note right of CU17
  Los reportes se generan a partir
  de la información disponible
  en el sistema.
end note

note right of CU18
  Los indicadores permiten consultar
  información consolidada de gestión
  operativa.
end note

@enduml
