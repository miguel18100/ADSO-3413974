@startuml
title Sistema Gestor de Ambulancias (SGA)\nDiagrama de Casos de Uso - G1-P1

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 40
skinparam ArrowColor #566573
skinparam usecase {
  BackgroundColor White
  BorderColor #2E4053
}

actor "Usuario del SGA" as Usuario <<abstract>>
actor "Personal operativo" as Personal <<abstract>>

actor Administrador as Admin
actor "Coordinador operativo" as Coordinador
actor "Paramédico TAB" as TAB
actor "Paramédico TAM" as TAM
actor "Analista / directivo" as Analista

Admin --|> Usuario
Coordinador --|> Personal
TAB --|> Personal
TAM --|> Personal
Personal --|> Usuario
Analista --|> Usuario

rectangle "Sistema Gestor de Ambulancias (SGA)" {

  package "Administración y acceso" {
    (CU-01 Iniciar sesión) as CU01
    (CU-02 Cerrar sesión) as CU02
    (CU-03 Consultar tablero operativo) as CU03
    (CU-04 Gestionar usuarios, roles y permisos) as CU04
  }

  package "Gestión de recursos" {
    (CU-05 Gestionar ambulancias) as CU05
    (CU-06 Gestionar personal operativo) as CU06
    (CU-07 Consultar disponibilidad de recursos) as CU07
  }

  package "Gestión de solicitudes y asignaciones" {
    (CU-08 Registrar solicitud de servicio) as CU08
    (CU-09 Gestionar solicitudes de servicio) as CU09
    (CU-10 Clasificar solicitud de servicio) as CU10
    (CU-11 Asignar ambulancia y personal) as CU11
    (CU-12 Consultar asignaciones) as CU12
  }

  package "Seguimiento operativo" {
    (CU-13 Actualizar estado del servicio) as CU13
    (CU-14 Gestionar novedades operativas) as CU14
    (CU-15 Consultar historial de servicios) as CU15
    (CU-20 Registrar datos básicos del paciente) as CU20
    (CU-21 Registrar intervenciones prehospitalarias) as CU21
    (CU-22 Cerrar servicio) as CU22
  }

  package "Informes, auditoría y documentación" {
    (CU-16 Generar reportes operativos) as CU16
    (CU-17 Consultar indicadores de gestión) as CU17
    (CU-18 Consultar auditoría operativa) as CU18
    (CU-19 Gestionar documentos y protocolos operativos) as CU19
  }
}

' Autenticación y acceso común
Usuario --> CU01
Usuario --> CU02
Usuario --> CU19

' Administración
Admin --> CU03
Admin --> CU04
Admin --> CU05
Admin --> CU06
Admin --> CU18

' Coordinación operativa
Coordinador --> CU03
Coordinador --> CU05
Coordinador --> CU06
Coordinador --> CU07
Coordinador --> CU08
Coordinador --> CU09
Coordinador --> CU10
Coordinador --> CU11
Coordinador --> CU12
Coordinador --> CU13
Coordinador --> CU14
Coordinador --> CU15
Coordinador --> CU16
Coordinador --> CU17
Coordinador --> CU22

' Personal de campo: objetivos comunes
Personal --> CU12
Personal --> CU13
Personal --> CU14
Personal --> CU15

' Paramédico TAB
TAB --> CU20

' Paramédico TAM
TAM --> CU20
TAM --> CU21

' Analista / directivo
Analista --> CU03
Analista --> CU15
Analista --> CU16
Analista --> CU17
Analista --> CU18

' Relaciones entre casos de uso
CU11 ..> CU07 : <<include>>

note bottom of CU11
La asignación requiere verificar la
clasificación y disponibilidad de
los recursos operativos.
end note

note bottom of CU14
Las novedades se registran durante
el seguimiento del servicio y conservan
trazabilidad y evidencia.
end note

note bottom of CU19
Gestiona documentos y protocolos
según los permisos del perfil.
Las acciones sensibles conservan
auditoría e integridad.
end note

note bottom of CU20
Registra datos básicos del paciente
vinculados al servicio prehospitalario.
No constituye una historia clínica
electrónica completa.
end note

note bottom of CU21
Registro de intervenciones realizadas
por el Paramédico TAM durante
el servicio prehospitalario.
end note

note bottom of CU22
El coordinador registra el cierre
operativo, resumen, condición de salida,
destino, tiempos y observaciones.
end note

@enduml

