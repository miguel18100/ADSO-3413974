flowchart TD
    A([Inicio]) --> B[Instructor inicia sesión]
    B --> C[Selecciona ficha]
    C --> D[Configura fecha hora y tolerancia]
    D --> E{¿Datos válidos?}
    E -- No --> F[Mostrar errores de validación]
    F --> D
    E -- Sí --> G[Crear sesión de asistencia]
    G --> H[Generar token y código de acceso]
    H --> I[Mostrar QR y código]
    I --> J[Consultar registros de la sesión]
    J --> K{¿Registrar manualmente?}
    K -- Sí --> L[Ingresar documento del aprendiz]
    L --> M[Buscar aprendiz activo]
    M --> N{¿Aprendiz pertenece a la ficha?}
    N -- No --> O[Informar rechazo]
    O --> J
    N -- Sí --> P[Validar sesión activa y vigente]
    P --> Q{¿Sesión válida?}
    Q -- No --> R[Informar sesión no disponible]
    R --> J
    Q -- Sí --> S[Guardar asistencia manual]
    S --> T{¿Registro duplicado?}
    T -- Sí --> U[Informar asistencia existente]
    U --> J
    T -- No --> V[Confirmar registro manual]
    V --> J
    K -- No --> W{¿Cerrar sesión?}
    W -- No --> J
    W -- Sí --> X[Desactivar sesión]
    X --> Y[Finalizar gestión]
    Y --> Z([Fin])
