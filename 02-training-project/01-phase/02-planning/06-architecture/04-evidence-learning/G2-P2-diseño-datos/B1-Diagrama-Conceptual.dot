 Solicitud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Solicitud</B></TD></TR><TR><TD ALIGN="LEFT">id_solicitud</TD></TR><TR><TD ALIGN="LEFT">fecha_recepcion</TD></TR><TR><TD ALIGN="LEFT">ubicacion_incidente</TD></TR><TR><TD ALIGN="LEFT">prioridad</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
 Servicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Servicio</B></TD></TR><TR><TD ALIGN="LEFT">id_servicio</TD></TR><TR><TD ALIGN="LEFT">fecha_inicio</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">fecha_finalizacion</TD></TR><TR><TD ALIGN="LEFT">destino</TD></TR></TABLE>>];
 Paciente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Paciente</B></TD></TR><TR><TD ALIGN="LEFT">id_paciente</TD></TR><TR><TD ALIGN="LEFT">identificacion_referencia</TD></TR><TR><TD ALIGN="LEFT">nombre_referencia</TD></TR><TR><TD ALIGN="LEFT">informacion_basica</TD></TR></TABLE>>];
 RegistroCierre [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>RegistroCierre</B></TD></TR><TR><TD ALIGN="LEFT">id_cierre</TD></TR><TR><TD ALIGN="LEFT">fecha_cierre</TD></TR><TR><TD ALIGN="LEFT">resumen_condicion</TD></TR><TR><TD ALIGN="LEFT">destino</TD></TR><TR><TD ALIGN="LEFT">observaciones_finales</TD></TR></TABLE>>];
 Ambulancia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Ambulancia</B></TD></TR><TR><TD ALIGN="LEFT">id_ambulancia</TD></TR><TR><TD ALIGN="LEFT">placa</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">estado_operativo</TD></TR><TR><TD ALIGN="LEFT">ubicacion_referencia</TD></TR></TABLE>>];
 Asignacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Asignacion</B></TD></TR><TR><TD ALIGN="LEFT">id_asignacion</TD></TR><TR><TD ALIGN="LEFT">fecha_asignacion</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
 Personal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Personal</B></TD></TR><TR><TD ALIGN="LEFT">id_personal</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">identificacion_referencia</TD></TR><TR><TD ALIGN="LEFT">perfil_operativo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">contacto</TD></TR></TABLE>>];
 AsignacionPersonal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#B7791F" BGCOLOR="#FFF7E4"><TR><TD BGCOLOR="#FBE8B7"><B>AsignacionPersonal</B></TD></TR><TR><TD ALIGN="LEFT">id_asignacion_personal</TD></TR><TR><TD ALIGN="LEFT">funcion</TD></TR><TR><TD ALIGN="LEFT">fecha_vinculacion</TD></TR></TABLE>>];
 Intervencion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Intervencion</B></TD></TR><TR><TD ALIGN="LEFT">id_intervencion</TD></TR><TR><TD ALIGN="LEFT">fecha_hora</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
 Rol -> Usuario [id="rel1", label="asigna\n0..* : 1..1"];
 Usuario -> Solicitud [id="rel2", label="registra\n0..* : 1..1"];
 Solicitud -> Servicio [id="rel3", label="origina\n0..1 : 1..1"];
 Paciente -> Servicio [id="rel4", label="recibe\n0..* : 1..1"];
 Servicio -> Asignacion [id="rel5", label="recibe\n0..* : 1..1"];
 Ambulancia -> Asignacion [id="rel6", label="participa en\n0..* : 1..1"];
 Asignacion -> AsignacionPersonal [id="rel7", label="incluye\n1..* : 1..1"];
 Personal -> AsignacionPersonal [id="rel8", label="integra\n0..* : 1..1"];
 Servicio -> Intervencion [id="rel9", label="registra\n0..* : 1..1"];
 Personal -> Intervencion [id="rel10", label="realiza\n0..* : 1..1"];
 Servicio -> RegistroCierre [id="rel11", label="documenta\n0..1 : 1..1"];
 Usuario -> RegistroCierre [id="rel12", label="registra\n0..* : 1..1", constraint=false, minlen=2];
