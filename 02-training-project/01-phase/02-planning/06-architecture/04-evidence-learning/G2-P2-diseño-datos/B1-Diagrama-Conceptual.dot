digraph B1 {
 graph [rankdir=TB, splines=polyline, overlap=false, nodesep=0.40, ranksep=0.75, bgcolor="white", pad=0.35, labelloc=t, label="B1 · Modelo conceptual de datos SIGMAVITAL", fontsize=20, fontname="Arial"];
 node [shape=record, style="filled", fillcolor="#EAF2F8", color="#287A83", fontname="Arial", fontsize=11, margin="0.16,0.10"];
