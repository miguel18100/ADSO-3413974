digraph B1 {
 graph [splines=true, overlap=false, sep=0.75, K=1.05, pad=0.5, margin=0.15, bgcolor="white", outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=c, fontsize=23, label="B1 · Modelo conceptual de datos SIGMAVITAL", fontcolor="#173449"];
 node [shape=plain, fontname="Arial", fontsize=11];
 edge [color="#526A7D", penwidth=1.65, arrowsize=0.68, arrowhead=vee, fontname="Arial", fontsize=8, fontcolor="#33485B", labelfontcolor="#33485B", labeldistance=1.65, labelangle=22, decorate=false];
 Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT">id_rol</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR></TABLE>>];
