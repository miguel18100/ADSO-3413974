digraph B2 {
 graph [splines=true, overlap=false, sep=0.75, K=1.05, pad=0.5, margin=0.15, bgcolor="white", outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=c, fontsize=23, label="B2 · Modelo relacional de datos SIGMAVITAL", fontcolor="#173449"];
 node [shape=plain, fontname="Arial", fontsize=11];
 edge [color="#526A7D", penwidth=1.65, arrowsize=0.68, arrowhead=vee, fontname="Arial", fontsize=8, fontcolor="#33485B", labelfontcolor="#33485B", labeldistance=1.65, labelangle=22, decorate=false];
 Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_rol</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR></TABLE>>];
 Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_usuario</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_rol</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">correo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">fecha_creacion</TD></TR></TABLE>>];
 Solicitud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Solicitud</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_solicitud</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_usuario</TD></TR><TR><TD ALIGN="LEFT">fecha_recepcion</TD></TR><TR><TD ALIGN="LEFT">ubicacion_incidente</TD></TR><TR><TD ALIGN="LEFT">prioridad</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR></TABLE>>];
 Servicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Servicio</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_servicio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK + UQ</B></FONT> &nbsp; id_solicitud</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_paciente</TD></TR><TR><TD ALIGN="LEFT">fecha_inicio</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">fecha_finalizacion</TD></TR><TR><TD ALIGN="LEFT">destino</TD></TR></TABLE>>];
 Paciente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Paciente</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_paciente</TD></TR><TR><TD ALIGN="LEFT">identificacion_referencia</TD></TR><TR><TD ALIGN="LEFT">nombre_referencia</TD></TR><TR><TD ALIGN="LEFT">informacion_basica</TD></TR></TABLE>>];
 RegistroCierre [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>RegistroCierre</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_cierre</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK + UQ</B></FONT> &nbsp; id_servicio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_usuario</TD></TR><TR><TD ALIGN="LEFT">fecha_cierre</TD></TR><TR><TD ALIGN="LEFT">resumen_condicion</TD></TR><TR><TD ALIGN="LEFT">destino</TD></TR><TR><TD ALIGN="LEFT">observaciones_finales</TD></TR></TABLE>>];
 Ambulancia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Ambulancia</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_ambulancia</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UQ</B></FONT> &nbsp; placa</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">estado_operativo</TD></TR><TR><TD ALIGN="LEFT">ubicacion_referencia</TD></TR></TABLE>>];
 Asignacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Asignacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_asignacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_servicio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_ambulancia</TD></TR><TR><TD ALIGN="LEFT">fecha_asignacion</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
 Personal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Personal</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_personal</TD></TR><TR><TD ALIGN="LEFT">nombre</TD></TR><TR><TD ALIGN="LEFT">identificacion_referencia</TD></TR><TR><TD ALIGN="LEFT">perfil_operativo</TD></TR><TR><TD ALIGN="LEFT">estado</TD></TR><TR><TD ALIGN="LEFT">contacto</TD></TR></TABLE>>];
 AsignacionPersonal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#B7791F" BGCOLOR="#FFF7E4"><TR><TD BGCOLOR="#FBE8B7"><B>AsignacionPersonal</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_asignacion_personal</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_asignacion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_personal</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9A3412"><B>UQ</B></FONT> &nbsp; (id_asignacion, id_personal)</TD></TR><TR><TD ALIGN="LEFT">funcion</TD></TR><TR><TD ALIGN="LEFT">fecha_vinculacion</TD></TR></TABLE>>];
 Intervencion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C7884" BGCOLOR="#EEF6F8"><TR><TD BGCOLOR="#D4E9EE"><B>Intervencion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#166534"><B>PK</B></FONT> &nbsp; id_intervencion</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_servicio</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1D4ED8"><B>FK</B></FONT> &nbsp; id_personal</TD></TR><TR><TD ALIGN="LEFT">fecha_hora</TD></TR><TR><TD ALIGN="LEFT">descripcion</TD></TR><TR><TD ALIGN="LEFT">observaciones</TD></TR></TABLE>>];
 Rol -> Usuario [id="rel1", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Usuario -> Solicitud [id="rel2", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Solicitud -> Servicio [id="rel3", dir=both, arrowtail=tee, arrowhead=odottee, label="1:0..1"];
 Paciente -> Servicio [id="rel4", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Servicio -> Asignacion [id="rel5", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Ambulancia -> Asignacion [id="rel6", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Asignacion -> AsignacionPersonal [id="rel7", dir=both, arrowtail=tee, arrowhead=teecrow, label="1:N"];
 Personal -> AsignacionPersonal [id="rel8", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Servicio -> Intervencion [id="rel9", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Personal -> Intervencion [id="rel10", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N"];
 Servicio -> RegistroCierre [id="rel11", dir=both, arrowtail=tee, arrowhead=odottee, label="1:0..1"];
 Usuario -> RegistroCierre [id="rel12", dir=both, arrowtail=tee, arrowhead=odotcrow, label="1:N", constraint=false, minlen=2];
