@startuml
!pragma layout smetana
title SIGMAVITAL - Diagrama de Clases A2

skinparam classAttributeIconSize 0

class Usuario {
  -idUsuario: int
  -nombre: String
  -correo: String
  -hashContrasena: String
  -activo: Boolean
  +autenticar(correo: String, contrasena: String): Boolean
  +actualizarDatos(nombre: String, correo: String): void
  +desactivar(): void
}

class Rol {
  -idRol: int
  -nombre: String
  -descripcion: String
  +asignarA(usuario: Usuario): void
  +revocarA(usuario: Usuario): void
  +consultarPermisos(): List<String>
}

class Ambulancia {
  -idAmbulancia: int
  -placa: String
  -tipo: String
  -estadoOperativo: String
  -ubicacion: String
  +actualizarEstado(estado: String): void
  +consultarDisponibilidad(): Boolean
  +actualizarUbicacion(ubicacion: String): void
}

class Personal {
  -idPersonal: int
  -nombre: String
  -documento: String
  -cargo: String
  -estado: String
  +actualizarEstado(estado: String): void
  +consultarDisponibilidad(): Boolean
  +validarParticipacion(): Boolean
}

class Solicitud {
  -idSolicitud: int
  -fechaHora: DateTime
  -descripcion: String
  -prioridad: String
  -estado: String
  +registrar(): void
  +actualizarEstado(estado: String): void
  +consultarDetalle(): String
}

class Servicio {
  -idServicio: int
  -fechaHoraInicio: DateTime
  -estado: String
  -observaciones: String
  +iniciar(): void
  +actualizarEstado(estado: String): void
  +consultarEstado(): String
  +finalizar(): void
}

class Asignacion {
  -idAsignacion: int
  -fechaHoraAsignacion: DateTime
  -estado: String
  -criterio: String
  +asignarAmbulancia(ambulancia: Ambulancia): void
  +validarDisponibilidad(): Boolean
  +cancelar(): void
}

class AsignacionPersonal {
  -idAsignacionPersonal: int
  -funcion: String
  -fechaHoraVinculacion: DateTime
  +vincularPersonal(personal: Personal): void
  +desvincularPersonal(): void
  +validarPerfil(): Boolean
}

class Paciente {
  -idPaciente: int
  -identificacion: String
  -nombre: String
  -fechaNacimiento: Date
  -datosMinimosRegistrados: Boolean
  +registrarDatosBasicos(): void
  +actualizarDatosBasicos(): void
  +consultarDatos(): String
}

class Intervencion {
  -idIntervencion: int
  -fechaHora: DateTime
  -descripcion: String
  -tipoIntervencion: String
  -responsable: String
  +registrar(): void
  +actualizarRegistro(): void
  +consultar(): String
}

class RegistroCierre {
  -idRegistroCierre: int
  -fechaHoraCierre: DateTime
  -condicionSalida: String
  -destinoAsistencial: String
  -resumenAtencion: String
  -observaciones: String
  +registrarCierre(): void
  +validarServicioFinalizado(): Boolean
  +consultarResumen(): String
}

interface EstrategiaAsignacion {
  +seleccionarAmbulancia(ambulancias: List<Ambulancia>, solicitud: Solicitud): Ambulancia
  +evaluar(ambulancia: Ambulancia, solicitud: Solicitud): Boolean
}

class EstrategiaAsignacionUrgente {
  +seleccionarAmbulancia(ambulancias: List<Ambulancia>, solicitud: Solicitud): Ambulancia
  +evaluar(ambulancia: Ambulancia, solicitud: Solicitud): Boolean
}

class EstrategiaAsignacionGeneral {
  +seleccionarAmbulancia(ambulancias: List<Ambulancia>, solicitud: Solicitud): Ambulancia
  +evaluar(ambulancia: Ambulancia, solicitud: Solicitud): Boolean
}

Usuario "0..*" -- "0..*" Rol : tiene
Usuario "1" -- "0..*" Solicitud : registra
Solicitud "1" -- "0..1" Servicio : genera
Servicio "1" *-- "0..*" Asignacion : contiene
Ambulancia "1" -- "0..*" Asignacion : participa
Asignacion "1" *-- "1..*" AsignacionPersonal : integra
Personal "1" -- "0..*" AsignacionPersonal : participa
Servicio "1" *-- "0..*" Intervencion : documenta
Servicio "1" *-- "0..1" RegistroCierre : consolida
Usuario "1" -- "0..*" RegistroCierre : registra

Asignacion ..> EstrategiaAsignacion : utiliza
EstrategiaAsignacion <|.. EstrategiaAsignacionUrgente
EstrategiaAsignacion <|.. EstrategiaAsignacionGeneral

Paciente "1" -- "0..*" Servicio : recibe atención


class GestionServicioFacade {
  +gestionarSolicitud(solicitud: Solicitud): Servicio
  +coordinarAsignacion(servicio: Servicio): Asignacion
  +finalizarServicio(servicio: Servicio): RegistroCierre
}

GestionServicioFacade ..> Solicitud : coordina
GestionServicioFacade ..> Asignacion : delega
GestionServicioFacade ..> Servicio : gestiona
GestionServicioFacade ..> RegistroCierre : coordina
@enduml


