@startuml
 title DA-02 - Asignar ambulancia y personal (CU-11)
 skinparam shadowing false
 skinparam activity {
   BackgroundColor #F6FAFD
   BorderColor #315B78
   DiamondBackgroundColor #FFF4D6
   DiamondBorderColor #9A6B16
   StartColor #1F6B52
   EndColor #8A3B3B
 }
 |Coordinador operativo|
 start
 :Seleccionar el servicio pendiente de asignación;
 |Sistema SIGMAVITAL|
 :Consultar y presentar los datos del servicio;
 |Coordinador operativo|
 :Solicitar consulta de recursos disponibles;
 |Sistema SIGMAVITAL|
 :Consultar ambulancias y personal disponibles;
 if (¿Existen recursos disponibles?) then ([sí])
 else ([no])
   :Informar que no hay recursos disponibles;
   |Coordinador operativo|
   if (¿Reintentar búsqueda?) then ([sí])
     :Solicitar nueva consulta;
     |Sistema SIGMAVITAL|
     :Actualizar consulta de disponibilidad;
     if (¿Ahora existen recursos?) then ([sí])
     else ([no])
       :Informar que la solicitud queda pendiente;
       stop
     endif
   else ([no])
     |Sistema SIGMAVITAL|
     :Mantener solicitud sin asignación;
     stop
   endif
 endif
 :Presentar opciones disponibles;
 |Coordinador operativo|
 :Seleccionar ambulancia y personal;
 |Sistema SIGMAVITAL|
 :Verificar disponibilidad vigente y compatibilidad;
 if (¿La selección es válida?) then ([sí])
 else ([no])
   :Informar incompatibilidad o cambio de disponibilidad;
   |Coordinador operativo|
   :Modificar recursos seleccionados;
   |Sistema SIGMAVITAL|
   :Revalidar disponibilidad y compatibilidad;
   if (¿La selección corregida es válida?) then ([sí])
   else ([no])
     :Informar que la selección continúa inválida;
     |Coordinador operativo|
     :Dejar la solicitud pendiente para revisión;
     stop
   endif
 endif
 |Coordinador operativo|
 :Confirmar la asignación;
 |Sistema SIGMAVITAL|
 repeat
  |Sistema SIGMAVITAL|
  :Registrar asignación y participaciones del personal;
  if (¿El registro se guardó?) then ([sí])
    :Actualizar estado de solicitud y recursos;
    :Mostrar confirmación de asignación;
    stop
  else ([no])
    :Informar que no fue posible guardar la asignación;
    |Coordinador operativo|
    if (¿Reintentar el registro?) then ([sí])
      :Decidir reintentar;
    else ([no])
      |Sistema SIGMAVITAL|
      :Mantener solicitud pendiente sin confirmación;
      stop
    endif
  endif
repeat while (Reintentar registro) is (sí)
@enduml



