@startuml
 title DA-03 - Cerrar servicio (CU-22)
 skinparam shadowing false
 skinparam activity {
   BackgroundColor #F6FAFD
   BorderColor #315B78
   DiamondBackgroundColor #FFF4D6
   DiamondBorderColor #9A6B16
   StartColor #1F6B52
   EndColor #8A3B3B
 }
 |Coordinador operativo|
 start
 :Seleccionar servicio finalizado;
 |Sistema SIGMAVITAL|
 :Consultar servicio, asignaciones e intervenciones;
 |Coordinador operativo|
 :Revisar información y completar resumen de atención, destino y observaciones;
 |Sistema SIGMAVITAL|
 :Validar campos obligatorios y consistencia de datos;
 if (¿La información está completa?) then ([sí])
 else ([no])
   :Mostrar campos faltantes o inconsistentes;
   |Coordinador operativo|
   :Completar o corregir información;
   |Sistema SIGMAVITAL|
   :Revalidar integridad y consistencia;
   if (¿La información corregida está completa?) then ([sí])
   else ([no])
     :Informar que no se puede continuar con el cierre;
     |Coordinador operativo|
     :Dejar el servicio abierto para completar datos;
     stop
   endif
 endif
 :Verificar que el servicio pueda cerrarse y que no exista un cierre previo;
 if (¿Se cumplen las reglas de cierre?) then ([sí])
 else ([no])
   :Informar la regla que impide el cierre;
   |Coordinador operativo|
   :Corregir la condición pendiente o cancelar;
   if (¿Solicita nueva validación?) then ([sí])
     |Sistema SIGMAVITAL|
     :Revalidar las reglas de cierre;
     if (¿Ahora se permite cerrar?) then ([sí])
     else ([no])
       :Mantener el servicio sin cerrar;
       stop
     endif
   else ([no])
     |Sistema SIGMAVITAL|
     :Conservar el estado actual del servicio;
     stop
   endif
 endif
 |Coordinador operativo|
 :Confirmar cierre del servicio;
 |Sistema SIGMAVITAL|
 :Guardar registro de cierre y actualizar estado del servicio;
 if (¿El cierre se guardó correctamente?) then ([sí])
   :Mostrar confirmación y habilitar consulta del cierre;
   stop
 else ([no])
   :Informar error y no confirmar el cierre;
   |Coordinador operativo|
   if (¿Reintentar guardado?) then ([sí])
     |Sistema SIGMAVITAL|
     :Reintentar guardado del cierre;
     if (¿El reintento fue exitoso?) then ([sí])
       :Actualizar estado del servicio y mostrar confirmación;
       stop
     else ([no])
       :Conservar estado previo y registrar error;
       stop
     endif
   else ([no])
     |Sistema SIGMAVITAL|
     :Conservar estado previo del servicio;
     stop
   endif
 endif
@enduml
