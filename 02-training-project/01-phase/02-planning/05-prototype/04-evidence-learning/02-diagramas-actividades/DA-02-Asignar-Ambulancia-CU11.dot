digraph DA02 {
 graph [rankdir=TB, compound=true, splines=ortho, nodesep=0.30, ranksep=0.42, bgcolor="white", label="DA-02 · Asignar ambulancia y personal (CU-11)", labelloc=t, fontsize=18, fontname="Arial", pad=0.25];
 node [shape=box, style="rounded,filled", fillcolor="#F6FAFD", color="#315B78", fontname="Arial", fontsize=10, margin="0.12,0.08"];
 edge [color="#526879", fontname="Arial", fontsize=9, arrowsize=0.7];
 start [shape=circle,label="Inicio",fillcolor="#D5E8D4",width=.55];
 stop1 [shape=doublecircle,label="Fin",fillcolor="#F8CECC",width=.55];
 subgraph cluster_coord { label="Carril · Coordinador operativo"; color="#7EA6C4"; style="rounded";
  c1 [label="Selecciona servicio pendiente"];
  c2 [label="Solicita consulta de recursos"];
  c3 [label="Selecciona ambulancia y personal"];
  c4 [label="Corrige selección o deja pendiente"];
  c5 [label="Confirma asignación"];
  c6 [label="Decide si reintenta registro"];
 }
 subgraph cluster_sys { label="Carril · Sistema SIGMAVITAL"; color="#87A878"; style="rounded";
  s1 [label="Consulta servicio"];
  s2 [label="Consulta disponibilidad"];
  d1 [shape=diamond,label="¿Hay recursos?",fillcolor="#FFF2CC"];
  s0 [label="Informa que no hay recursos disponibles"];
  d0 [shape=diamond,label="¿Reintentar búsqueda?",fillcolor="#FFF2CC"];
  s3 [label="Presenta opciones disponibles"];
  s4 [label="Valida disponibilidad y compatibilidad"];
  d2 [shape=diamond,label="¿Selección válida?",fillcolor="#FFF2CC"];
  s5 [label="Informa incompatibilidad / cambio"];
  s6 [label="Registra asignación y participaciones"];
  d3 [shape=diamond,label="¿Guardado?",fillcolor="#FFF2CC"];
  s7 [label="Actualiza estados y confirma"];
  s8 [label="Informa que queda pendiente"];
  s9 [label="Reintenta registro"];
 }
 start -> c1 -> s1 -> c2 -> s2 -> d1;
 d1 -> s3 [label="[sí]"];
 d1 -> s0 [label="[no]"];
 s0 -> d0;
 d0 -> s2 [label="[sí] · nueva consulta"];
 d0 -> s8 [label="[no]"];
 s3 -> c3 -> s4 -> d2;
 d2 -> c5 [label="[sí]"];
 d2 -> s5 [label="[no]"];
 s5 -> c4 -> s4 [label="[corregir]"];
 c4 -> s8 [label="[no corregir]"];
 c5 -> s6 -> d3;
 d3 -> s7 [label="[sí]"];
 d3 -> c6 [label="[no]"];
 c6 -> s9 [label="[sí]"];
 s9 -> d3 [label="[reintento]"];
 c6 -> s8 [label="[no]"];
 s7 -> stop1; s8 -> stop1;
}
